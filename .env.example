# ---- Stripe (Mike's account — see MIKE-HANDOVER.md) ----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Printful (token lives in theofficialgayguy-site/.env.local until store repo owns it) ----
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# ---- Behavior switches ----
# DEMO_CHECKOUT=1  -> checkout works without Stripe (fake success) so the store is fully clickable pre-keys
# FULFILL=on       -> webhook actually creates Printful orders (leave off until launch day)
DEMO_CHECKOUT=1
FULFILL=off

# Public absolute origin of the deployed site (used for print-file URLs sent to Printful)
NEXT_PUBLIC_SITE_URL=http://localhost:5396
